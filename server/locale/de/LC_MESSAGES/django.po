#: templates/core/administration.html:34
msgid "AI"
msgstr "KI"

#: rentalars/ai/auto.py:646
msgid ""
"Nothing to do: automatic summaries are off or another run is under way."
msgstr ""
"Nichts zu tun: Die automatischen Zusammenfassungen sind aus, oder ein "
"anderer Lauf ist im Gang."

#: rentalars/ai/auto.py:652
#, python-format
msgid ""
"%(done)s summarised, %(same)s unchanged, %(failed)s failed, %(tokens)s "
"tokens."
msgstr ""
"%(done)s zusammengefasst, %(same)s unverändert, %(failed)s fehlgeschlagen, "
"%(tokens)s Token."

#: rentalars/ai/auto.py:659
#, python-format
msgid "Stopped: %(reason)s."
msgstr "Angehalten: %(reason)s."

#: rentalars/ai/auto.py:666
msgid "the token budget of the night is used up"
msgstr "das Token-Budget der Nacht ist aufgebraucht"

#: rentalars/ai/auto.py:667
msgid "the most summaries per night are made"
msgstr "die höchste Zahl von Zusammenfassungen pro Nacht ist erreicht"

#: rentalars/ai/auto.py:668
msgid "the window of the night is over"
msgstr "das Zeitfenster der Nacht ist vorbei"

#: rentalars/ai/auto.py:669
msgid "the provider could not be reached or kept failing"
msgstr "der Anbieter war nicht erreichbar oder schlug immer wieder fehl"

#: rentalars/ai/auto.py:670
msgid ""
"the provider is not the one that was agreed to – switch the summaries on "
"again"
msgstr ""
"der Anbieter ist nicht der, dem zugestimmt wurde – schalte die "
"Zusammenfassungen neu ein"

#: rentalars/ai/auto.py:671
msgid "the run was interrupted"
msgstr "der Lauf wurde unterbrochen"

#: rentalars/ai/auto.py:672
msgid "an unexpected error, see the log"
msgstr "ein unerwarteter Fehler, siehe Protokoll"

#: rentalars/ai/client.py:151 rentalars/ai/models.py:91
#: templates/ai/settings.html:14
msgid "Local AI"
msgstr "Lokale KI"

#: rentalars/ai/client.py:170
#, python-format
msgid ""
"“%(name)s” is reached over the internet without encryption (http://). Use an"
" address with https://."
msgstr ""
"„%(name)s“ wird über das Internet ohne Verschlüsselung (http://) erreicht. "
"Nimm eine Adresse mit https://."

#: rentalars/ai/client.py:177
#, python-format
msgid ""
"The API key of “%(name)s” cannot be read any more (the secret key changed). "
"Enter it again."
msgstr ""
"Der API-Schlüssel von „%(name)s“ ist nicht mehr lesbar (der geheime "
"Schlüssel hat sich geändert). Gib ihn neu ein."

#: rentalars/ai/client.py:216
msgid "This use of AI is switched off in the settings."
msgstr "Dieser Anwendungsfall der KI ist in den Einstellungen ausgeschaltet."

#: rentalars/ai/client.py:260
#, python-format
msgid "%(provider)s refused the API key (HTTP %(code)s)."
msgstr "%(provider)s hat den API-Schlüssel abgelehnt (HTTP %(code)s)."

#: rentalars/ai/client.py:265
#, python-format
msgid "%(provider)s does not know this address or model (HTTP 404)."
msgstr "%(provider)s kennt diese Adresse oder dieses Modell nicht (HTTP 404)."

#: rentalars/ai/client.py:267
#, python-format
msgid ""
"%(provider)s is busy or the limit of the account is reached (HTTP 429)."
msgstr ""
"%(provider)s ist ausgelastet oder das Limit des Kontos ist erreicht (HTTP "
"429)."

#: rentalars/ai/client.py:270
#, python-format
msgid "%(provider)s answered with an error (HTTP %(code)s)."
msgstr "%(provider)s hat mit einem Fehler geantwortet (HTTP %(code)s)."

#: rentalars/ai/client.py:278
#, python-format
msgid "%(provider)s did not answer in time."
msgstr "%(provider)s hat nicht rechtzeitig geantwortet."

#: rentalars/ai/client.py:281
msgid "The local AI does not answer. Is the service rentalars-ai running?"
msgstr "Die lokale KI antwortet nicht. Läuft der Dienst rentalars-ai?"

#: rentalars/ai/client.py:282 rentalars/ai/client.py:283
#, python-format
msgid "%(provider)s cannot be reached."
msgstr "%(provider)s ist nicht erreichbar."

#: rentalars/ai/client.py:485
#, python-format
msgid "%(provider)s took longer than expected; the task was stopped."
msgstr ""
"%(provider)s hat länger gebraucht als erwartet; die Aufgabe wurde "
"abgebrochen."

#: rentalars/ai/client.py:489 rentalars/ai/client.py:635
#, python-format
msgid "%(provider)s gave an answer Rentalars cannot use."
msgstr ""
"%(provider)s hat eine Antwort gegeben, mit der Rentalars nichts anfangen "
"kann."

#: rentalars/ai/client.py:696 rentalars/ai/client.py:700
#: rentalars/api/models.py:104 rentalars/api/models.py:115
msgid "This is not a valid address."
msgstr "Das ist keine gültige Adresse."

#: rentalars/ai/client.py:698 rentalars/api/models.py:106
#: rentalars/personnel/calendar_client.py:124
msgid "Only addresses beginning with https:// or http:// can be used."
msgstr "Es gehen nur Adressen, die mit https:// oder http:// beginnen."

#: rentalars/ai/client.py:703
msgid ""
"Leave user name and password out of the address; enter the key in the field "
"“API key”."
msgstr ""
"Lass Benutzername und Passwort aus der Adresse weg; trag den Schlüssel im "
"Feld „API-Schlüssel“ ein."

#: rentalars/ai/client.py:707
msgid "The address ends before “?” and “#”."
msgstr "Die Adresse endet vor „?“ und „#“."

#: rentalars/ai/client.py:715
msgid ""
"An address on the internet must begin with https:// – mails and the key "
"would go unencrypted."
msgstr ""
"Eine Adresse im Internet muss mit https:// beginnen – sonst gingen Mails und"
" Schlüssel unverschlüsselt."

#: rentalars/ai/drafts.py:58
msgid "There is no received mail to answer."
msgstr "Es gibt keine empfangene Mail zum Beantworten."

#: rentalars/ai/drafts.py:90
#, python-format
msgid "Reply draft for %(project)s"
msgstr "Antwortentwurf für %(project)s"

#: rentalars/ai/drafts.py:138 rentalars/documents/statements.py:2051
#, python-format
msgid "reads the mails … %(percent)s %%"
msgstr "liest die Mails … %(percent)s %%"

#: rentalars/ai/drafts.py:141 rentalars/ai/invoices.py:353
#: rentalars/ai/legacy_invoices.py:178
msgid "thinks …"
msgstr "denkt nach …"

#: rentalars/ai/drafts.py:143 rentalars/ai/invoices.py:355
#: rentalars/ai/legacy_invoices.py:180 rentalars/documents/statements.py:2054
#, python-format
msgid "writes … %(words)s words"
msgstr "schreibt … %(words)s Wörter"

#: rentalars/ai/drafts.py:175
msgid "The draft is ready."
msgstr "Der Entwurf ist fertig."

#: rentalars/ai/forms.py:44 rentalars/ai/models.py:80
msgid "Summary of the correspondence"
msgstr "Zusammenfassung der Korrespondenz"

#: rentalars/ai/forms.py:46
msgid ""
"Who summarises the mails of a project. The mails go there and nowhere else. "
"The short overview without AI is always there."
msgstr ""
"Wer die Mails eines Projekts zusammenfasst. Die Mails gehen dorthin und "
"nirgends sonst. Den Kurzüberblick ohne KI gibt es immer."

#: rentalars/ai/forms.py:51 rentalars/ai/models.py:81
msgid "Reply draft for mails"
msgstr "Antwortentwurf für Mails"

#: rentalars/ai/forms.py:52
msgid ""
"In “Write mail”, the AI suggests a reply from the mails so far; you check it"
" and send it."
msgstr ""
"In „Mail schreiben“ schlägt die KI eine Antwort aus den bisherigen Mails "
"vor; du prüfst und sendest sie."

#: rentalars/ai/forms.py:56 rentalars/ai/models.py:83
msgid "Reading invoices"
msgstr "Rechnungen lesen"

#: rentalars/ai/forms.py:58
msgid ""
"In “Enter a purchase”, the AI reads an uploaded invoice (PDF with text) and "
"suggests supplier, number, date and positions; you check every row before "
"anything is created. Off: only number, date and supplier are taken from the "
"text."
msgstr ""
"In „Kauf einpflegen“ liest die KI eine hochgeladene Rechnung (PDF mit Text) "
"und schlägt Händler, Nummer, Datum und Positionen vor; du prüfst jede Zeile,"
" bevor etwas angelegt wird. Aus: Nur Nummer, Datum und Händler werden aus "
"dem Text übernommen."

#: rentalars/ai/forms.py:94 rentalars/ai/models.py:111
#: rentalars/documents/accounting_forms.py:49 templates/ai/settings.html:96
#: templates/ai/settings.html:101 templates/documents/accounting.html:31
msgid "API key"
msgstr "API-Schlüssel"

#: rentalars/ai/forms.py:98
msgid ""
"Leave it empty to keep the stored key. Local servers usually need none."
msgstr ""
"Leer lassen, um den gespeicherten Schlüssel zu behalten. Lokale Server "
"brauchen meist keinen."

#: rentalars/ai/forms.py:100
msgid "Remove the stored key"
msgstr "Gespeicherten Schlüssel entfernen"

#: rentalars/ai/forms.py:123
msgid ""
"Where the interface answers, usually ending in /v1 – e.g. "
"http://192.168.1.30:11434/v1 for Ollama in the company network. Internal "
"addresses only if the operator allows them in the configuration file."
msgstr ""
"Wo die Schnittstelle antwortet, meist mit /v1 am Ende – z. B. "
"http://192.168.1.30:11434/v1 für Ollama im Firmennetz. Interne Adressen nur,"
" wenn der Betreiber sie in der Konfigurationsdatei freigibt."

#: rentalars/ai/forms.py:152
msgid "Bank data: IBAN"
msgstr "Bankdaten: IBAN"

#: rentalars/ai/forms.py:153
msgid "Bank data: card numbers"
msgstr "Bankdaten: Kartennummern"

#: rentalars/ai/forms.py:154
msgid "Secrets: passwords, tokens, keys in links"
msgstr "Geheimnisse: Passwörter, Token, Schlüssel in Links"

#: rentalars/ai/forms.py:155
msgid "E-mail addresses"
msgstr "E-Mail-Adressen"

#: rentalars/ai/forms.py:156
msgid "Phone numbers"
msgstr "Telefonnummern"

#: rentalars/ai/forms.py:168
msgid "Taken out of every text before it goes to the AI"
msgstr "Aus jedem Text entfernt, bevor er an die KI geht"

#: rentalars/ai/forms.py:173
msgid ""
"Applies to summaries by hand and to the automatic ones. Recognised by their "
"shape; names, street addresses and what is said in free text cannot be "
"recognised."
msgstr ""
"Gilt für Zusammenfassungen von Hand und für die automatischen. Erkannt wird,"
" was eine erkennbare Form hat; Namen, Straßenadressen und was im Freitext "
"steht, lassen sich nicht erkennen."

#: rentalars/ai/forms.py:178
msgid "Projects in these statuses"
msgstr "Projekte in diesen Status"

#: rentalars/ai/forms.py:184
msgid "Service cases in these statuses"
msgstr "Servicefälle in diesen Status"

#: rentalars/ai/forms.py:190
