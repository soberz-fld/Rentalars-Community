#: rentalars/documents/datev.py:457
msgid ""
"Enter the consultant number and the client number under Settings → "
"Accounting first."
msgstr ""
"Trage zuerst die Beraternummer und die Mandantennummer unter Einstellungen →"
" Buchhaltung ein."

#: rentalars/documents/datev.py:459
msgid "Choose the first and the last day of the period."
msgstr "Wähle den ersten und den letzten Tag des Zeitraums."

#: rentalars/documents/datev.py:461
msgid "The period ends before it begins."
msgstr "Der Zeitraum endet, bevor er beginnt."

#: rentalars/documents/datev.py:464
#, python-format
msgid ""
"The period must lie within one fiscal year: DATEV takes one batch per fiscal"
" year (from %(start)s)."
msgstr ""
"Der Zeitraum muss innerhalb eines Wirtschaftsjahres liegen: DATEV nimmt "
"einen Stapel je Wirtschaftsjahr (ab %(start)s)."

#: rentalars/documents/datev.py:491
msgid "Enter the collective debtor account under Settings → Accounting first."
msgstr ""
"Trage zuerst das Sammel-Debitorenkonto unter Einstellungen → Buchhaltung "
"ein."

#: rentalars/documents/datev.py:496
#, python-format
msgid ""
"Customer “%(name)s” has the number “%(number)s”, which is not made of digits"
" only; it cannot become a debtor account. Use a collective debtor account or"
" give the customer a number of digits."
msgstr ""
"Kunde „%(name)s“ hat die Nummer „%(number)s“, die nicht nur aus Ziffern "
"besteht; daraus wird kein Debitorenkonto. Nimm ein Sammel-Debitorenkonto "
"oder gib dem Kunden eine Nummer aus Ziffern."

#: rentalars/documents/datev.py:506
#, python-format
msgid ""
"Customer %(number)s “%(name)s” would get the debtor account %(account)d, but"
" debtor accounts lie between %(low)d and %(high)d. Change the number added "
"to the customer number."
msgstr ""
"Kunde %(number)s „%(name)s“ würde das Debitorenkonto %(account)d bekommen, "
"Debitorenkonten liegen aber zwischen %(low)d und %(high)d. Ändere den "
"Zuschlag auf die Kundennummer."

#: rentalars/documents/datev.py:553
#, python-format
msgid "There is no revenue account for the tax rate of %(rate)s %%."
msgstr "Für den Steuersatz von %(rate)s %% gibt es kein Erlöskonto."

#: rentalars/documents/datev.py:580
#, python-format
msgid "Invoices %(start)s–%(end)s"
msgstr "Rechnungen %(start)s–%(end)s"

#: rentalars/documents/datev.py:613
msgid ""
"All customers are booked on one collective debtor account; there are no "
"debtors to export."
msgstr ""
"Alle Kunden werden auf einem Sammelkonto gebucht; es gibt keine Debitoren zu"
" exportieren."

#: rentalars/documents/datev.py:641
msgid "Customers of Rentalars"
msgstr "Kunden aus Rentalars"

#: rentalars/documents/einvoice_check.py:43
msgid "This document has no e-invoice."
msgstr "Dieser Beleg hat keine E-Rechnung."

#: rentalars/documents/einvoice_check.py:90
msgid "This invoice has no e-invoice."
msgstr "Diese Rechnung hat keine E-Rechnung."

#: rentalars/documents/einvoice_check.py:95 rentalars/incoming/services.py:363
msgid "The e-invoice file cannot be opened."
msgstr "Die E-Rechnungsdatei lässt sich nicht öffnen."

#: rentalars/documents/einvoice_rules.py:502
#: rentalars/incoming/einvoice.py:550
#, python-format
msgid ""
"The XML is not an e-invoice we know (UBL Invoice or CreditNote, or UN/CEFACT"
" CrossIndustryInvoice); its root element is “%(name)s”."
msgstr ""
"Das XML ist keine E-Rechnung, die wir kennen (UBL Invoice oder CreditNote "
"oder UN/CEFACT CrossIndustryInvoice); sein Wurzelelement heißt „%(name)s“."

#: rentalars/documents/einvoice_rules.py:539
msgid "The specification identifier is missing."
msgstr "Die Kennung der Spezifikation fehlt."

#: rentalars/documents/einvoice_rules.py:541
msgid "The invoice number is missing."
msgstr "Die Rechnungsnummer fehlt."

#: rentalars/documents/einvoice_rules.py:543
msgid "The invoice date is missing."
msgstr "Das Rechnungsdatum fehlt."

#: rentalars/documents/einvoice_rules.py:545
msgid "The invoice date is not a date."
msgstr "Das Rechnungsdatum ist kein Datum."

#: rentalars/documents/einvoice_rules.py:547
msgid "The type of the invoice (type code) is missing."
msgstr "Die Art der Rechnung (Typ-Code) fehlt."

#: rentalars/documents/einvoice_rules.py:549
msgid "The currency is missing or not a three-letter code."
msgstr "Die Währung fehlt oder ist kein Code aus drei Buchstaben."

#: rentalars/documents/einvoice_rules.py:551
#: rentalars/documents/einvoice_rules.py:753
msgid "seller"
msgstr "Verkäufer"

#: rentalars/documents/einvoice_rules.py:552
#: rentalars/documents/einvoice_rules.py:753
#: rentalars/material/sale_models.py:60
msgid "buyer"
msgstr "Käufer"

#: rentalars/documents/einvoice_rules.py:556
#, python-format
msgid "The name of the %(side)s is missing."
msgstr "Beim %(side)s fehlt der Name."

#: rentalars/documents/einvoice_rules.py:558
#, python-format
msgid "The address of the %(side)s is missing."
msgstr "Beim %(side)s fehlt die Anschrift."

#: rentalars/documents/einvoice_rules.py:562
#, python-format
msgid "The country of the %(side)s is missing or not a two-letter code."
msgstr ""
"Beim %(side)s fehlt das Land, oder es ist kein Code aus zwei Buchstaben."

#: rentalars/documents/einvoice_rules.py:566
msgid "The sum of the line amounts is missing."
msgstr "Die Summe der Positionsbeträge fehlt."

#: rentalars/documents/einvoice_rules.py:568
msgid "The invoice total without tax is missing."
msgstr "Der Rechnungsbetrag ohne Steuer fehlt."

#: rentalars/documents/einvoice_rules.py:570
msgid "The invoice total with tax is missing."
msgstr "Der Rechnungsbetrag mit Steuer fehlt."

#: rentalars/documents/einvoice_rules.py:572
msgid "The amount due for payment is missing."
msgstr "Der Zahlbetrag fehlt."

#: rentalars/documents/einvoice_rules.py:574
msgid "The invoice has no line."
msgstr "Die Rechnung hat keine Position."

#: rentalars/documents/einvoice_rules.py:576
#, python-format
msgid "line %(number)s"
msgstr "Position %(number)s"

#: rentalars/documents/einvoice_rules.py:578
#, python-format
msgid "A line has no identifier (%(label)s)."
msgstr "Eine Position hat keine Kennung (%(label)s)."

#: rentalars/documents/einvoice_rules.py:580
#, python-format
msgid "The quantity is missing (%(label)s)."
msgstr "Die Menge fehlt (%(label)s)."

#: rentalars/documents/einvoice_rules.py:582
#, python-format
msgid "The unit of the quantity is missing (%(label)s)."
msgstr "Die Einheit der Menge fehlt (%(label)s)."

#: rentalars/documents/einvoice_rules.py:584
#, python-format
msgid "The net amount is missing (%(label)s)."
msgstr "Der Nettobetrag fehlt (%(label)s)."

#: rentalars/documents/einvoice_rules.py:586
#, python-format
msgid "The name of the item is missing (%(label)s)."
msgstr "Der Name des Artikels fehlt (%(label)s)."

#: rentalars/documents/einvoice_rules.py:588
#, python-format
msgid "The net price is missing (%(label)s)."
msgstr "Der Nettopreis fehlt (%(label)s)."

#: rentalars/documents/einvoice_rules.py:590
#, python-format
msgid "The net price is negative (%(label)s)."
msgstr "Der Nettopreis ist negativ (%(label)s)."

#: rentalars/documents/einvoice_rules.py:592
#, python-format
msgid "The tax category is missing (%(label)s)."
msgstr "Die Steuerkategorie fehlt (%(label)s)."

#: rentalars/documents/einvoice_rules.py:604
#, python-format
msgid ""
"The sum of the lines (%(lines)s) is not the sum of the line amounts "
"(%(total)s)."
msgstr ""
"Die Summe der Positionen (%(lines)s) ist nicht die Summe der "
"Positionsbeträge (%(total)s)."

#: rentalars/documents/einvoice_rules.py:614
#, python-format
msgid ""
"The lines less allowances plus charges (%(expected)s) are not the total "
"without tax (%(total)s)."
msgstr ""
"Die Positionen abzüglich Nachlässen und zuzüglich Aufschlägen (%(expected)s)"
" sind nicht der Betrag ohne Steuer (%(total)s)."

#: rentalars/documents/einvoice_rules.py:623
#, python-format
msgid ""
"The sum of the allowances (%(listed)s) is not the total of the allowances "
"(%(total)s)."
msgstr ""
"Die Summe der Nachlässe (%(listed)s) ist nicht die Gesamtsumme der Nachlässe"
" (%(total)s)."

#: rentalars/documents/einvoice_rules.py:632
#, python-format
msgid ""
"The sum of the charges (%(listed)s) is not the total of the charges "
"(%(total)s)."
msgstr ""
"Die Summe der Aufschläge (%(listed)s) ist nicht die Gesamtsumme der "
"Aufschläge (%(total)s)."

#: rentalars/documents/einvoice_rules.py:637
msgid "The tax breakdown is missing."
msgstr "Die Aufschlüsselung der Steuer fehlt."

#: rentalars/documents/einvoice_rules.py:642
#, python-format
msgid ""
"The tax amounts of the breakdown (%(sum)s) are not the total tax "
"(%(total)s)."
msgstr ""
"Die Steuerbeträge der Aufschlüsselung (%(sum)s) sind nicht die Gesamtsteuer "
"(%(total)s)."

#: rentalars/documents/einvoice_rules.py:651
#, python-format
msgid ""
"The total without tax (%(net)s) plus the tax (%(tax)s) is not the total with"
" tax (%(gross)s)."
msgstr ""
"Der Betrag ohne Steuer (%(net)s) plus die Steuer (%(tax)s) ist nicht der "
"Betrag mit Steuer (%(gross)s)."

#: rentalars/documents/einvoice_rules.py:660
#, python-format
msgid ""
"The total with tax less the prepaid amount (%(expected)s) is not the amount "
"due (%(due)s)."
msgstr ""
"Der Betrag mit Steuer abzüglich des bereits gezahlten Betrags (%(expected)s)"
" ist nicht der Zahlbetrag (%(due)s)."

#: rentalars/documents/einvoice_rules.py:670
#, python-format
msgid "The taxable amount is missing (%(label)s)."
msgstr "Der steuerpflichtige Betrag fehlt (%(label)s)."

#: rentalars/documents/einvoice_rules.py:672
#, python-format
msgid "The tax amount is missing (%(label)s)."
msgstr "Der Steuerbetrag fehlt (%(label)s)."

#: rentalars/documents/einvoice_rules.py:674
msgid "The tax category is missing in the breakdown."
msgstr "Die Steuerkategorie fehlt in der Aufschlüsselung."

#: rentalars/documents/einvoice_rules.py:677
#, python-format
msgid "The tax rate is missing (%(label)s)."
msgstr "Der Steuersatz fehlt (%(label)s)."

#: rentalars/documents/einvoice_rules.py:681
#, python-format
msgid "A reason for the exemption is missing (%(label)s)."
msgstr "Ein Grund für die Befreiung fehlt (%(label)s)."

#: rentalars/documents/einvoice_rules.py:685
#, python-format
msgid "The standard rate must be above zero (%(label)s)."
msgstr "Der Regelsatz muss über null liegen (%(label)s)."

#: rentalars/documents/einvoice_rules.py:697
#, python-format
msgid ""
"The tax amount (%(amount)s) is not the taxable amount times the rate "
"(%(expected)s) (%(label)s)."
msgstr ""
"Der Steuerbetrag (%(amount)s) ist nicht der steuerpflichtige Betrag mal dem "
"Satz (%(expected)s) (%(label)s)."

#: rentalars/documents/einvoice_rules.py:719
#, python-format
msgid ""
"Lines have the tax category and rate %(label)s, the breakdown has none for "
"it."
msgstr ""
"Positionen haben die Steuerkategorie und den Satz %(label)s, die "
"Aufschlüsselung hat dazu keine Zeile."

#: rentalars/documents/einvoice_rules.py:726
#, python-format
msgid ""
"The taxable amount of %(label)s (%(basis)s) is not the lines of this rate "
"less allowances plus charges (%(expected)s)."
msgstr ""
"Der steuerpflichtige Betrag von %(label)s (%(basis)s) ist nicht die Summe "
"der Positionen dieses Satzes abzüglich Nachlässen und zuzüglich Aufschlägen "
"(%(expected)s)."

#: rentalars/documents/einvoice_rules.py:736
msgid "An amount is due, but there is neither a due date nor a payment term."
msgstr ""
"Es ist ein Betrag fällig, aber weder ein Fälligkeitsdatum noch eine "
"Zahlungsbedingung angegeben."

#: rentalars/documents/einvoice_rules.py:739
msgid "A credit transfer needs the IBAN of the account to pay to."
msgstr "Eine Überweisung braucht die IBAN des Kontos, auf das gezahlt wird."

#: rentalars/documents/einvoice_rules.py:741
#, python-format
msgid "The check digits of the IBAN %(iban)s do not fit."
msgstr "Die Prüfziffern der IBAN %(iban)s passen nicht."

#: rentalars/documents/einvoice_rules.py:746
msgid ""
"The seller needs an identifier: VAT ID, tax number, registration number or "
"another identifier."
msgstr ""
"Der Verkäufer braucht eine Kennung: USt-IdNr., Steuernummer, Registernummer "
"oder eine andere Kennung."

#: rentalars/documents/einvoice_rules.py:750
msgid "The VAT ID of the seller must start with the country code."
msgstr "Die USt-IdNr. des Verkäufers muss mit dem Ländercode beginnen."

#: rentalars/documents/einvoice_rules.py:752
msgid "The VAT ID of the buyer must start with the country code."
msgstr "Die USt-IdNr. des Käufers muss mit dem Ländercode beginnen."

#: rentalars/documents/einvoice_rules.py:757
#, python-format
msgid "The German VAT ID of the %(side)s should be DE and nine digits."
msgstr ""
"Die deutsche USt-IdNr. (%(side)s) sollte aus DE und neun Ziffern bestehen."

#: rentalars/documents/einvoice_rules.py:777
msgid ""
"The specification identifier is not that of an XRechnung "
"(urn:cen.eu:en16931:2017#compliant#urn:xeinkauf.de:kosit:xrechnung_3.0)."
msgstr ""
"Die Spezifikationskennung ist nicht die einer XRechnung "
"(urn:cen.eu:en16931:2017#compliant#urn:xeinkauf.de:kosit:xrechnung_3.0)."

#: rentalars/documents/einvoice_rules.py:782
msgid "An XRechnung needs payment instructions."
msgstr "Eine XRechnung braucht Zahlungsangaben."

#: rentalars/documents/einvoice_rules.py:785
msgid "An XRechnung needs the contact of the seller."
msgstr "Eine XRechnung braucht den Kontakt des Verkäufers."

#: rentalars/documents/einvoice_rules.py:787
msgid "The city of the seller is missing."
msgstr "Der Ort des Verkäufers fehlt."

#: rentalars/documents/einvoice_rules.py:789
msgid "The postal code of the seller is missing."
msgstr "Die Postleitzahl des Verkäufers fehlt."

#: rentalars/documents/einvoice_rules.py:792
msgid "The name of the contact of the seller is missing."
msgstr "Der Name des Ansprechpartners beim Verkäufer fehlt."

#: rentalars/documents/einvoice_rules.py:794
msgid "The telephone number of the contact of the seller is missing."
msgstr "Die Telefonnummer des Ansprechpartners beim Verkäufer fehlt."

#: rentalars/documents/einvoice_rules.py:796
msgid "The e-mail address of the contact of the seller is missing."
msgstr "Die E-Mail-Adresse des Ansprechpartners beim Verkäufer fehlt."

#: rentalars/documents/einvoice_rules.py:798
msgid "The city of the buyer is missing."
msgstr "Der Ort des Käufers fehlt."

#: rentalars/documents/einvoice_rules.py:800
msgid "The postal code of the buyer is missing."
msgstr "Die Postleitzahl des Käufers fehlt."

#: rentalars/documents/einvoice_rules.py:802
