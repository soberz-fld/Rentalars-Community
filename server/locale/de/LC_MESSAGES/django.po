msgstr "Interne Adressen"

#: rentalars/core/selfcheck.py:890
#, python-format
msgid ""
"%(list)s. Rentalars does not connect there. Allow the address in the "
"configuration file ([network] allow_internal) or change the setting."
msgstr ""
"%(list)s. Dorthin verbindet sich Rentalars nicht. Gib die Adresse in der "
"Konfigurationsdatei frei ([network] allow_internal) oder ändere die "
"Einstellung."

#: rentalars/core/selfcheck.py:896
msgid "No setting leads into an internal network."
msgstr "Keine Einstellung führt in ein internes Netz."

#: rentalars/core/selfcheck.py:899
msgid "Allowed internal addresses"
msgstr "Erlaubte interne Adressen"

#: rentalars/core/selfcheck.py:901
