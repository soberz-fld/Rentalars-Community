# Small clean-up jobs: expired sessions, old login attempts (NFA-036).
# Started once a day by rentalars-maintenance.timer.

[Unit]
Description=Rentalars – tägliche Aufräumarbeiten
After=mariadb.service

[Service]
Type=oneshot
User=rentalars
Group=rentalars
Environment=RENTALARS_CONFIG=/etc/rentalars/rentalars.conf
ExecStart=/opt/rentalars/venv/bin/python /opt/rentalars/app/manage.py run_daily_maintenance
